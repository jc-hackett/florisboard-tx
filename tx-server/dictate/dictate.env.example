# dictate service settings. Leave ANTHROPIC_API_KEY empty until the Cutscene Labs
# (BAA-covered) Console key exists; while empty, the Claude cleanup step is skipped.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
HF_HUB_OFFLINE=1

# Speech model (Moonshine, streaming) and where its files live.
MOONSHINE_ARCH=MEDIUM_STREAMING
MOONSHINE_CACHE=/opt/dictate/models/moonshine
# claude = de-identified Claude tidy (~1 s); local = on-box tidy only (instant).
CLEANUP_MODE=local
